{
  "nodeModulesDir": "none",
  "minimumDependencyAge": {
    "exclude": [
      "jsr:@aricart/*",
      "npm:@aricart/*"
    ]
  },
  "imports": {
    "@aricart/cobra": "jsr:@aricart/cobra@^0.2.0",
    "@nats-io/jetstream": "jsr:@nats-io/jetstream@3.5.0",
    "@nats-io/kv": "jsr:@nats-io/kv@3.5.0",
    "@nats-io/nats-core": "jsr:@nats-io/nats-core@3.5.0",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@3.5.0",
    "@nats-io/transport-node": "npm:@nats-io/transport-node@3.5.0"
  },
  "tasks": {
    "bench": "deno run --allow-net --allow-read --allow-write bench.js"
